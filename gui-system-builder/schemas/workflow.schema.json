{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gui-operation-suite:workflow:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "profile_name",
    "goal",
    "preconditions",
    "steps",
    "completion",
    "restoration"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "profile_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "intent",
          "action",
          "expected",
          "repetition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "intent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "selector": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "identifier": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "context": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "window_title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          },
          "action": {
            "enum": [
              "observe",
              "activate",
              "press",
              "set-value",
              "type",
              "hotkey",
              "scroll",
              "drag",
              "wait",
              "verify",
              "save",
              "submit"
            ]
          },
          "expected": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "repetition": {
            "enum": [
              "safe-after-check",
              "inspect-before-repeat",
              "never-automatic"
            ]
          }
        }
      }
    },
    "completion": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "restoration": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    }
  },
  "description": "Outcome instructions for an agent, not a blind macro. profile_tools.py also checks unique step IDs and save/submit repetition policies."
}
